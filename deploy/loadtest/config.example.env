# Exact API prefix exposed by the target environment. Do not append a trailing slash.
LOADTEST_API_BASE_URL=https://flow.example.com/api
LOADTEST_HEALTH_URL=https://flow.example.com/livez

# Prefer LOADTEST_CREDENTIALS_FILE for concurrent tests. The file must be outside Git.
# Format: [{"username":"loadtest-01","password":"..."}]
LOADTEST_CREDENTIALS_FILE=
LOADTEST_USERNAME=
LOADTEST_PASSWORD=

# The default profile is deliberately short. Set soak explicitly for the 6h30m run.
LOADTEST_PROFILE=smoke
# Required for every non-smoke profile; must exactly match LOADTEST_API_BASE_URL.
LOADTEST_CONFIRM_TARGET=
LOADTEST_BASE_RATE=8
LOADTEST_PEAK_RATE=24
LOADTEST_SPIKE_RATE=48
LOADTEST_MAX_VUS=120
LOADTEST_WRITE_PERCENT=3
LOADTEST_AUTH_RATE_PER_MINUTE=2

# Writes are disabled until explicitly accepted for an isolated test environment.
LOADTEST_ALLOW_WRITES=false
# Set to isolated-test-environment only after isolation and backup checks pass.
LOADTEST_CONFIRM_WRITES=
LOADTEST_ENABLE_FILE_LIFECYCLE=false

# Optional published entity fixture. Both files must stay outside Git.
LOADTEST_ENTITY_CODE=
LOADTEST_ENTITY_LIST_KEY=
LOADTEST_ENTITY_CREATE_BODY_FILE=
LOADTEST_ENTITY_UPDATE_BODY_FILE=

# Pass only public/non-secret identifiers through this file.
LOADTEST_RUN_ID=
LOADTEST_RESULT_ROOT=deploy/loadtest/results

# Optional local k3s observation. Disable when the target cluster is remote and
# kubectl on the load generator is not configured for it.
LOADTEST_OBSERVE_K8S=false
FLOW_NAMESPACE=flow
FLOW_RELEASE=flow
OBSERVABILITY_NAMESPACE=flow-observability

# Tooling and thresholds.
K6_IMAGE=grafana/k6:2.0.0
LOADTEST_HTTP_ERROR_RATE=0.005
LOADTEST_BUSINESS_ERROR_RATE=0.005
LOADTEST_READ_P95_MS=750
LOADTEST_WRITE_P95_MS=1500
LOADTEST_P99_MS=2500
LOADTEST_TOKEN_REFRESH_SECONDS=600
LOADTEST_INSECURE_SKIP_TLS_VERIFY=false
