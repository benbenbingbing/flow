{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "server", "web", "database", "storage", "openApi"],
  "properties": {
    "application": {
      "type": "object",
      "properties": {
        "httpAllowPrivateAddresses": {
          "type": "boolean"
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["existingSecret", "allowMutableImages"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "allowMutableImages": {
          "type": "boolean"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "server": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "web": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^jdbc:mysql://"
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["endpoint", "region", "bucket"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "openApi": {
      "type": "object",
      "required": [
        "enabled",
        "issuer",
        "audience",
        "accessTokenTtl",
        "keyId",
        "privateKeySecretKey",
        "publicKeySecretKey",
        "previousPublicKeys",
        "tokenClientLimitPerMinute",
        "tokenAddressLimitPerMinute",
        "trustForwardedHeaders",
        "trustedProxyCidrs",
        "webhook"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issuer": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "accessTokenTtl": {
          "type": "string",
          "pattern": "^([1-9]|[12][0-9]|30)m$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]{1,64}$"
        },
        "privateKeySecretKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,253}$"
        },
        "publicKeySecretKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,253}$"
        },
        "previousPublicKeys": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["keyId", "secretKey", "fileName"],
            "properties": {
              "keyId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,64}$"
              },
              "secretKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,253}$"
              },
              "fileName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$"
              }
            },
            "additionalProperties": false
          }
        },
        "tokenClientLimitPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "tokenAddressLimitPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "trustForwardedHeaders": {
          "type": "boolean"
        },
        "trustedProxyCidrs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64
          }
        },
        "webhook": {
          "type": "object",
          "required": [
            "enabled",
            "masterKeySecretKey",
            "workerConcurrency",
            "workerQueueCapacity",
            "workerBatchSize",
            "workerLeaseSeconds",
            "workerDelayMs",
            "metricsRefreshMs"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "masterKeySecretKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,253}$"
            },
            "workerConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "workerQueueCapacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "workerBatchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "workerLeaseSeconds": {
              "type": "integer",
              "minimum": 15,
              "maximum": 300
            },
            "workerDelayMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            "metricsRefreshMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "allowMutableImages": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "server": {
            "properties": {
              "image": {
                "required": ["digest"],
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          "web": {
            "properties": {
              "image": {
                "required": ["digest"],
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          ]
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    }
  }
}
