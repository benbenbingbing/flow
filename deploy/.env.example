DB_NAME=workflow
DB_USERNAME=workflow
DB_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_PASSWORD=replace-with-a-different-strong-app-password
SCHEMA_DB_USERNAME=workflow_schema
SCHEMA_DB_PASSWORD=replace-with-a-different-schema-publisher-password
JWT_SECRET=replace-with-a-long-random-secret
# 浏览器使用 HTTPS 时为 true；同源 HTTP 部署显式改为 false，否则刷新 Cookie 不会随请求发送。
AUTH_SESSION_COOKIE_SECURE=true
WORKFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
FILE_STORAGE_S3_ENDPOINT=https://s3.example.com
FILE_STORAGE_S3_REGION=us-east-1
FILE_STORAGE_S3_BUCKET=flow-production
FILE_STORAGE_S3_ACCESS_KEY=replace-with-an-s3-access-key
# Required: inject through the deployment environment or secret manager.
FILE_STORAGE_S3_SECRET_KEY=
FILE_STORAGE_S3_ACCESS_URL=
FILE_STORAGE_S3_PATH_STYLE=false

FLOWABLE_SCHEMA_UPDATE=false
APP_LOG_LEVEL=INFO
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=160m
WEB_PORT=80
