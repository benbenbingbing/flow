{
  "$schema": "../../../../schemas/extension.schema.json",
  "schemaVersion": 1,
  "type": "LIST_CELL",
  "name": "DemoRiskProgressCell",
  "label": "Demo·风险进度",
  "description": "用进度条和风险标签展示 0-100 风险评分。",
  "version": 1,
  "enabled": true,
  "implementation": {
    "path": "src/extensions/examples/demo/list-fields/DemoRiskProgressCell.vue",
    "export": "default",
    "kind": "COMPONENT"
  },
  "metadata": {
    "supportedFieldTypes": [
      "INTEGER",
      "LONG",
      "DECIMAL",
      "DOUBLE"
    ],
    "configSchema": [
      {
        "key": "warningAt",
        "label": "关注阈值",
        "type": "number",
        "min": 0,
        "max": 100,
        "defaultValue": 40
      },
      {
        "key": "dangerAt",
        "label": "高危阈值",
        "type": "number",
        "min": 0,
        "max": 100,
        "defaultValue": 70
      },
      {
        "key": "showText",
        "label": "显示百分比",
        "type": "boolean",
        "defaultValue": true
      },
      {
        "key": "showLevel",
        "label": "显示风险等级",
        "type": "boolean",
        "defaultValue": true
      }
    ]
  },
  "$comment": "注册声明：实现路径可位于所属模块；name 是已发布配置引用的稳定名称。修改后由构建器自动安装，不另写注册代码。"
}
