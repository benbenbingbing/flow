{
  "$schema": "../../../../schemas/extension.schema.json",
  "schemaVersion": 1,
  "type": "LIST",
  "name": "DemoProjectCardList",
  "label": "Demo·项目卡片列表",
  "description": "项目卡片、风险进度、标准权限操作和平台分页的完整示例。",
  "version": 1,
  "enabled": true,
  "implementation": {
    "path": "src/extensions/examples/demo/lists/DemoProjectCardList.vue",
    "export": "default",
    "kind": "COMPONENT"
  },
  "metadata": {
    "configSchema": [
      {
        "key": "columns",
        "label": "卡片列数",
        "type": "number",
        "min": 1,
        "max": 4,
        "defaultValue": 3
      },
      {
        "key": "compact",
        "label": "紧凑模式",
        "type": "boolean",
        "defaultValue": false
      },
      {
        "key": "showDescription",
        "label": "显示项目说明",
        "type": "boolean",
        "defaultValue": true
      },
      {
        "key": "searchPlaceholder",
        "label": "搜索提示",
        "type": "text",
        "defaultValue": "搜索项目名称"
      }
    ],
    "capabilities": {
      "layout": "card",
      "reusesPlatformActions": true
    },
    "usageContexts": [
      "PAGE"
    ]
  },
  "$comment": "注册声明：实现路径可位于所属模块；name 是已发布配置引用的稳定名称。修改后由构建器自动安装，不另写注册代码。"
}
