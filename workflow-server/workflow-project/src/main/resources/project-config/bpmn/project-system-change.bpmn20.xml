<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://workflow.com/project">
  <process id="project_system_change_process" name="项目系统关系变更审批" isExecutable="true">
    <startEvent id="start" name="提交项目系统变更">
      <outgoing>flow_start_manager</outgoing>
    </startEvent>
    <userTask id="project_manager_review" name="项目经理确认" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project_system_change_request/project_system_change_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;确认提交变更&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_start_manager</incoming>
      <outgoing>flow_manager_result</outgoing>
    </userTask>
    <exclusiveGateway id="manager_result" name="项目经理确认结果" default="flow_manager_approve">
      <incoming>flow_manager_result</incoming>
      <outgoing>flow_manager_reject</outgoing>
      <outgoing>flow_manager_approve</outgoing>
    </exclusiveGateway>
    <userTask id="system_owner_review" name="系统负责人审批" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project_system_change_request/project_system_change_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;系统边界通过&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_manager_approve</incoming>
      <outgoing>flow_system_result</outgoing>
    </userTask>
    <exclusiveGateway id="system_result" name="系统审批结果" default="flow_system_approve">
      <incoming>flow_system_result</incoming>
      <outgoing>flow_system_reject</outgoing>
      <outgoing>flow_system_approve</outgoing>
    </exclusiveGateway>
    <userTask id="technical_review" name="技术负责人审批" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project_system_change_request/project_system_change_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;技术影响通过&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_system_approve</incoming>
      <outgoing>flow_technical_result</outgoing>
    </userTask>
    <exclusiveGateway id="technical_result" name="技术审批结果" default="flow_technical_approve">
      <incoming>flow_technical_result</incoming>
      <outgoing>flow_technical_reject</outgoing>
      <outgoing>flow_technical_approve</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="architecture_needed" name="架构评审判断" default="flow_skip_architecture">
      <incoming>flow_technical_approve</incoming>
      <outgoing>flow_need_architecture</outgoing>
      <outgoing>flow_skip_architecture</outgoing>
    </exclusiveGateway>
    <userTask id="architecture_review" name="架构影响评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project_system_change_request/project_system_change_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;架构影响可接受&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_architecture</incoming>
      <outgoing>flow_architecture_result</outgoing>
    </userTask>
    <exclusiveGateway id="architecture_result" name="架构评审结果" default="flow_architecture_approve">
      <incoming>flow_architecture_result</incoming>
      <outgoing>flow_architecture_reject</outgoing>
      <outgoing>flow_architecture_approve</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="security_needed" name="安全评审判断" default="flow_skip_security">
      <incoming>flow_skip_architecture</incoming>
      <incoming>flow_architecture_approve</incoming>
      <outgoing>flow_need_security</outgoing>
      <outgoing>flow_skip_security</outgoing>
    </exclusiveGateway>
    <userTask id="security_review" name="安全影响评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project_system_change_request/project_system_change_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;安全影响可接受&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_security</incoming>
      <outgoing>flow_security_result</outgoing>
    </userTask>
    <exclusiveGateway id="security_result" name="安全评审结果" default="flow_security_approve">
      <incoming>flow_security_result</incoming>
      <outgoing>flow_security_reject</outgoing>
      <outgoing>flow_security_approve</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="data_needed" name="数据评审判断" default="flow_skip_data">
      <incoming>flow_skip_security</incoming>
      <incoming>flow_security_approve</incoming>
      <outgoing>flow_need_data</outgoing>
      <outgoing>flow_skip_data</outgoing>
    </exclusiveGateway>
    <userTask id="data_review" name="数据影响评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project_system_change_request/project_system_change_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;数据影响可接受&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_data</incoming>
      <outgoing>flow_data_result</outgoing>
    </userTask>
    <exclusiveGateway id="data_result" name="数据评审结果" default="flow_data_approve">
      <incoming>flow_data_result</incoming>
      <outgoing>flow_data_reject</outgoing>
      <outgoing>flow_data_approve</outgoing>
    </exclusiveGateway>
    <userTask id="pmo_review" name="PMO纳入基线审批" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project_system_change_request/project_system_change_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;批准并纳入基线&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;不批准变更&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_skip_data</incoming>
      <incoming>flow_data_approve</incoming>
      <outgoing>flow_pmo_result</outgoing>
    </userTask>
    <exclusiveGateway id="pmo_result" name="PMO审批结果" default="flow_pmo_approve">
      <incoming>flow_pmo_result</incoming>
      <outgoing>flow_pmo_reject</outgoing>
      <outgoing>flow_pmo_approve</outgoing>
    </exclusiveGateway>
    <endEvent id="end_approved" name="变更已批准">
      <incoming>flow_pmo_approve</incoming>
    </endEvent>
    <endEvent id="end_rejected" name="变更已驳回">
      <incoming>flow_manager_reject</incoming>
      <incoming>flow_system_reject</incoming>
      <incoming>flow_technical_reject</incoming>
      <incoming>flow_architecture_reject</incoming>
      <incoming>flow_security_reject</incoming>
      <incoming>flow_data_reject</incoming>
      <incoming>flow_pmo_reject</incoming>
    </endEvent>
    <sequenceFlow id="flow_start_manager" sourceRef="start" targetRef="project_manager_review" />
    <sequenceFlow id="flow_manager_result" sourceRef="project_manager_review" targetRef="manager_result" />
    <sequenceFlow id="flow_manager_reject" sourceRef="manager_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_manager_approve" sourceRef="manager_result" targetRef="system_owner_review" />
    <sequenceFlow id="flow_system_result" sourceRef="system_owner_review" targetRef="system_result" />
    <sequenceFlow id="flow_system_reject" sourceRef="system_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_system_approve" sourceRef="system_result" targetRef="technical_review" />
    <sequenceFlow id="flow_technical_result" sourceRef="technical_review" targetRef="technical_result" />
    <sequenceFlow id="flow_technical_reject" sourceRef="technical_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_technical_approve" sourceRef="technical_result" targetRef="architecture_needed" />
    <sequenceFlow id="flow_need_architecture" sourceRef="architecture_needed" targetRef="architecture_review">
      <conditionExpression xsi:type="tFormalExpression">${risk_level == 'HIGH' || risk_level == 'CRITICAL' || operation_type == 'REMOVE'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_architecture" sourceRef="architecture_needed" targetRef="security_needed" />
    <sequenceFlow id="flow_architecture_result" sourceRef="architecture_review" targetRef="architecture_result" />
    <sequenceFlow id="flow_architecture_reject" sourceRef="architecture_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_architecture_approve" sourceRef="architecture_result" targetRef="security_needed" />
    <sequenceFlow id="flow_need_security" sourceRef="security_needed" targetRef="security_review">
      <conditionExpression xsi:type="tFormalExpression">${security_involved_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_security" sourceRef="security_needed" targetRef="data_needed" />
    <sequenceFlow id="flow_security_result" sourceRef="security_review" targetRef="security_result" />
    <sequenceFlow id="flow_security_reject" sourceRef="security_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_security_approve" sourceRef="security_result" targetRef="data_needed" />
    <sequenceFlow id="flow_need_data" sourceRef="data_needed" targetRef="data_review">
      <conditionExpression xsi:type="tFormalExpression">${data_involved_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_data" sourceRef="data_needed" targetRef="pmo_review" />
    <sequenceFlow id="flow_data_result" sourceRef="data_review" targetRef="data_result" />
    <sequenceFlow id="flow_data_reject" sourceRef="data_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_data_approve" sourceRef="data_result" targetRef="pmo_review" />
    <sequenceFlow id="flow_pmo_result" sourceRef="pmo_review" targetRef="pmo_result" />
    <sequenceFlow id="flow_pmo_reject" sourceRef="pmo_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_pmo_approve" sourceRef="pmo_result" targetRef="end_approved" />
  </process>
