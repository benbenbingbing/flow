<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://workflow.com/project">
  <process id="requirement_intake_process" name="需求申请与入池审批" isExecutable="true">
    <startEvent id="start" name="提交需求">
      <outgoing>flow_start_business</outgoing>
    </startEvent>
    <sequenceFlow id="flow_start_business" sourceRef="start" targetRef="business_review" />
    <userTask id="business_review" name="业务负责人审核" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://requirement/requirement_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&#34;enabled&#34;:true,&#34;commentLabel&#34;:&#34;业务审核意见&#34;,&#34;options&#34;:[{&#34;value&#34;:&#34;approve&#34;,&#34;label&#34;:&#34;同意进入评估&#34;,&#34;type&#34;:&#34;primary&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;reject&#34;,&#34;label&#34;:&#34;驳回&#34;,&#34;type&#34;:&#34;danger&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_start_business</incoming>
      <outgoing>flow_business_result</outgoing>
    </userTask>
    <sequenceFlow id="flow_business_result" sourceRef="business_review" targetRef="business_result" />
    <exclusiveGateway id="business_result" default="flow_business_approve">
      <incoming>flow_business_result</incoming>
      <outgoing>flow_business_reject</outgoing>
      <outgoing>flow_business_approve</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_business_reject" sourceRef="business_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_business_approve" sourceRef="business_result" targetRef="requirement_manager_review" />
    <userTask id="requirement_manager_review" name="需求经理评估" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://requirement/requirement_assessment">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&#34;enabled&#34;:true,&#34;commentLabel&#34;:&#34;需求评估意见&#34;,&#34;options&#34;:[{&#34;value&#34;:&#34;approve&#34;,&#34;label&#34;:&#34;完成评估&#34;,&#34;type&#34;:&#34;primary&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;reject&#34;,&#34;label&#34;:&#34;不予受理&#34;,&#34;type&#34;:&#34;danger&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_business_approve</incoming>
      <outgoing>flow_manager_result</outgoing>
    </userTask>
    <sequenceFlow id="flow_manager_result" sourceRef="requirement_manager_review" targetRef="manager_result" />
    <exclusiveGateway id="manager_result" default="flow_manager_approve">
      <incoming>flow_manager_result</incoming>
      <outgoing>flow_manager_reject</outgoing>
      <outgoing>flow_manager_approve</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_manager_reject" sourceRef="manager_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_manager_approve" sourceRef="manager_result" targetRef="system_scope_gateway" />
    <exclusiveGateway id="system_scope_gateway" default="flow_no_systems">
      <incoming>flow_manager_approve</incoming>
      <outgoing>flow_has_systems</outgoing>
      <outgoing>flow_no_systems</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_has_systems" sourceRef="system_scope_gateway" targetRef="system_owner_review">
      <conditionExpression xsi:type="tFormalExpression">${system_impact_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_no_systems" sourceRef="system_scope_gateway" targetRef="security_needed" />
    <userTask id="system_owner_review" name="涉及系统负责人会签" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://requirement/requirement_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&#34;enabled&#34;:true,&#34;commentLabel&#34;:&#34;系统影响意见&#34;,&#34;options&#34;:[{&#34;value&#34;:&#34;approve&#34;,&#34;label&#34;:&#34;同意系统影响结论&#34;,&#34;type&#34;:&#34;primary&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;reject&#34;,&#34;label&#34;:&#34;不同意&#34;,&#34;type&#34;:&#34;danger&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_has_systems</incoming>
      <outgoing>flow_system_result</outgoing>
    </userTask>
    <sequenceFlow id="flow_system_result" sourceRef="system_owner_review" targetRef="system_result" />
    <exclusiveGateway id="system_result" default="flow_system_approve">
      <incoming>flow_system_result</incoming>
      <outgoing>flow_system_reject</outgoing>
      <outgoing>flow_system_approve</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_system_reject" sourceRef="system_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_system_approve" sourceRef="system_result" targetRef="architecture_review" />
    <userTask id="architecture_review" name="架构影响评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://requirement/requirement_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&#34;enabled&#34;:true,&#34;commentLabel&#34;:&#34;架构评审意见&#34;,&#34;options&#34;:[{&#34;value&#34;:&#34;approve&#34;,&#34;label&#34;:&#34;架构可行&#34;,&#34;type&#34;:&#34;primary&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;reject&#34;,&#34;label&#34;:&#34;架构不可行&#34;,&#34;type&#34;:&#34;danger&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_system_approve</incoming>
      <outgoing>flow_architecture_result</outgoing>
    </userTask>
    <sequenceFlow id="flow_architecture_result" sourceRef="architecture_review" targetRef="architecture_result" />
    <exclusiveGateway id="architecture_result" default="flow_architecture_approve">
      <incoming>flow_architecture_result</incoming>
      <outgoing>flow_architecture_reject</outgoing>
      <outgoing>flow_architecture_approve</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_architecture_reject" sourceRef="architecture_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_architecture_approve" sourceRef="architecture_result" targetRef="security_needed" />
    <exclusiveGateway id="security_needed" default="flow_skip_security">
      <incoming>flow_no_systems</incoming>
      <incoming>flow_architecture_approve</incoming>
      <outgoing>flow_need_security</outgoing>
      <outgoing>flow_skip_security</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_need_security" sourceRef="security_needed" targetRef="security_review">
      <conditionExpression xsi:type="tFormalExpression">${security_involved_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_security" sourceRef="security_needed" targetRef="data_needed" />
    <userTask id="security_review" name="安全影响评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://requirement/requirement_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&#34;enabled&#34;:true,&#34;commentLabel&#34;:&#34;安全评审意见&#34;,&#34;options&#34;:[{&#34;value&#34;:&#34;approve&#34;,&#34;label&#34;:&#34;安全可接受&#34;,&#34;type&#34;:&#34;primary&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;reject&#34;,&#34;label&#34;:&#34;安全风险不可接受&#34;,&#34;type&#34;:&#34;danger&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_security</incoming>
      <outgoing>flow_security_result</outgoing>
    </userTask>
    <sequenceFlow id="flow_security_result" sourceRef="security_review" targetRef="security_result" />
    <exclusiveGateway id="security_result" default="flow_security_approve">
      <incoming>flow_security_result</incoming>
      <outgoing>flow_security_reject</outgoing>
      <outgoing>flow_security_approve</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_security_reject" sourceRef="security_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_security_approve" sourceRef="security_result" targetRef="data_needed" />
    <exclusiveGateway id="data_needed" default="flow_skip_data">
      <incoming>flow_skip_security</incoming>
      <incoming>flow_security_approve</incoming>
      <outgoing>flow_need_data</outgoing>
      <outgoing>flow_skip_data</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_need_data" sourceRef="data_needed" targetRef="data_review">
      <conditionExpression xsi:type="tFormalExpression">${data_involved_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_data" sourceRef="data_needed" targetRef="requirement_decision" />
    <userTask id="data_review" name="数据影响评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://requirement/requirement_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&#34;enabled&#34;:true,&#34;commentLabel&#34;:&#34;数据评审意见&#34;,&#34;options&#34;:[{&#34;value&#34;:&#34;approve&#34;,&#34;label&#34;:&#34;数据方案可行&#34;,&#34;type&#34;:&#34;primary&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;reject&#34;,&#34;label&#34;:&#34;数据方案不可行&#34;,&#34;type&#34;:&#34;danger&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_data</incoming>
      <outgoing>flow_data_result</outgoing>
    </userTask>
    <sequenceFlow id="flow_data_result" sourceRef="data_review" targetRef="data_result" />
    <exclusiveGateway id="data_result" default="flow_data_approve">
      <incoming>flow_data_result</incoming>
      <outgoing>flow_data_reject</outgoing>
      <outgoing>flow_data_approve</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_data_reject" sourceRef="data_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_data_approve" sourceRef="data_result" targetRef="requirement_decision" />
    <userTask id="requirement_decision" name="需求入池决策" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://requirement/requirement_assessment">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&#34;enabled&#34;:true,&#34;commentLabel&#34;:&#34;入池决策意见&#34;,&#34;options&#34;:[{&#34;value&#34;:&#34;backlog&#34;,&#34;label&#34;:&#34;进入需求池&#34;,&#34;type&#34;:&#34;primary&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;planned&#34;,&#34;label&#34;:&#34;纳入近期计划&#34;,&#34;type&#34;:&#34;success&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:false},{&#34;value&#34;:&#34;merged&#34;,&#34;label&#34;:&#34;合并到已有需求&#34;,&#34;type&#34;:&#34;warning&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true},{&#34;value&#34;:&#34;reject&#34;,&#34;label&#34;:&#34;驳回&#34;,&#34;type&#34;:&#34;danger&#34;,&#34;showComment&#34;:true,&#34;remarkRequired&#34;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_skip_data</incoming>
      <incoming>flow_data_approve</incoming>
      <outgoing>flow_decision_result</outgoing>
    </userTask>
    <sequenceFlow id="flow_decision_result" sourceRef="requirement_decision" targetRef="decision_result" />
    <exclusiveGateway id="decision_result" default="flow_decision_backlog">
      <incoming>flow_decision_result</incoming>
      <outgoing>flow_decision_reject</outgoing>
      <outgoing>flow_decision_planned</outgoing>
      <outgoing>flow_decision_merged</outgoing>
      <outgoing>flow_decision_backlog</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="flow_decision_reject" sourceRef="decision_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_decision_planned" sourceRef="decision_result" targetRef="end_planned">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'planned'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_decision_merged" sourceRef="decision_result" targetRef="end_merged">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'merged'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_decision_backlog" sourceRef="decision_result" targetRef="end_backlog" />
    <endEvent id="end_rejected" name="已驳回">
      <incoming>flow_business_reject</incoming>
      <incoming>flow_manager_reject</incoming>
      <incoming>flow_system_reject</incoming>
      <incoming>flow_architecture_reject</incoming>
      <incoming>flow_security_reject</incoming>
      <incoming>flow_data_reject</incoming>
      <incoming>flow_decision_reject</incoming>
    </endEvent>
    <endEvent id="end_backlog" name="已进入需求池">
      <incoming>flow_decision_backlog</incoming>
    </endEvent>
    <endEvent id="end_planned" name="已纳入计划">
      <incoming>flow_decision_planned</incoming>
    </endEvent>
    <endEvent id="end_merged" name="已合并">
      <incoming>flow_decision_merged</incoming>
    </endEvent>
  </process>
