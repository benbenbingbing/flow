<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://workflow.com/project">
  <process id="project_initiation_process" name="项目立项审批" isExecutable="true">
    <startEvent id="start" name="提交项目立项">
      <outgoing>flow_start_business</outgoing>
    </startEvent>
    <userTask id="business_review" name="业务负责人审核" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project/project_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;确认目标与范围&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_start_business</incoming>
      <outgoing>flow_business_result</outgoing>
    </userTask>
    <exclusiveGateway id="business_result" name="业务审核结果" default="flow_business_approve">
      <incoming>flow_business_result</incoming>
      <outgoing>flow_business_reject</outgoing>
      <outgoing>flow_business_approve</outgoing>
    </exclusiveGateway>
    <userTask id="pmo_review" name="PMO立项评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project/project_governance_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;PMO审核通过&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_business_approve</incoming>
      <outgoing>flow_pmo_result</outgoing>
    </userTask>
    <exclusiveGateway id="pmo_result" name="PMO评审结果" default="flow_pmo_approve">
      <incoming>flow_pmo_result</incoming>
      <outgoing>flow_pmo_reject</outgoing>
      <outgoing>flow_pmo_approve</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="system_needed" name="系统会签判断" default="flow_skip_system">
      <incoming>flow_pmo_approve</incoming>
      <outgoing>flow_need_system</outgoing>
      <outgoing>flow_skip_system</outgoing>
    </exclusiveGateway>
    <userTask id="system_owner_review" name="关联系统负责人会签" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project/project_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;系统范围通过&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_system</incoming>
      <outgoing>flow_system_result</outgoing>
    </userTask>
    <exclusiveGateway id="system_result" name="系统会签结果" default="flow_system_approve">
      <incoming>flow_system_result</incoming>
      <outgoing>flow_system_reject</outgoing>
      <outgoing>flow_system_approve</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="architecture_needed" name="架构评审判断" default="flow_skip_architecture">
      <incoming>flow_skip_system</incoming>
      <incoming>flow_system_approve</incoming>
      <outgoing>flow_need_architecture</outgoing>
      <outgoing>flow_skip_architecture</outgoing>
    </exclusiveGateway>
    <userTask id="architecture_review" name="企业架构评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project/project_governance_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;架构方案可行&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_architecture</incoming>
      <outgoing>flow_architecture_result</outgoing>
    </userTask>
    <exclusiveGateway id="architecture_result" name="架构评审结果" default="flow_architecture_approve">
      <incoming>flow_architecture_result</incoming>
      <outgoing>flow_architecture_reject</outgoing>
      <outgoing>flow_architecture_approve</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="security_needed" name="安全评审判断" default="flow_skip_security">
      <incoming>flow_skip_architecture</incoming>
      <incoming>flow_architecture_approve</incoming>
      <outgoing>flow_need_security</outgoing>
      <outgoing>flow_skip_security</outgoing>
    </exclusiveGateway>
    <userTask id="security_review" name="安全专项评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project/project_governance_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;安全要求通过&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_security</incoming>
      <outgoing>flow_security_result</outgoing>
    </userTask>
    <exclusiveGateway id="security_result" name="安全评审结果" default="flow_security_approve">
      <incoming>flow_security_result</incoming>
      <outgoing>flow_security_reject</outgoing>
      <outgoing>flow_security_approve</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="data_needed" name="数据评审判断" default="flow_skip_data">
      <incoming>flow_skip_security</incoming>
      <incoming>flow_security_approve</incoming>
      <outgoing>flow_need_data</outgoing>
      <outgoing>flow_skip_data</outgoing>
    </exclusiveGateway>
    <userTask id="data_review" name="数据专项评审" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project/project_governance_review">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;数据方案通过&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;驳回&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_need_data</incoming>
      <outgoing>flow_data_result</outgoing>
    </userTask>
    <exclusiveGateway id="data_result" name="数据评审结果" default="flow_data_approve">
      <incoming>flow_data_result</incoming>
      <outgoing>flow_data_reject</outgoing>
      <outgoing>flow_data_approve</outgoing>
    </exclusiveGateway>
    <userTask id="sponsor_review" name="项目发起人最终批准" flowable:assignee="wf-user://admin" flowable:formKey="wf-form://project/project_detail">
      <extensionElements>
        <flowable:properties>
          <flowable:property name="approvalConfig" value="{&quot;enabled&quot;:true,&quot;commentLabel&quot;:&quot;审批意见&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;approve&quot;,&quot;label&quot;:&quot;批准立项&quot;,&quot;type&quot;:&quot;primary&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:false},{&quot;value&quot;:&quot;reject&quot;,&quot;label&quot;:&quot;不批准立项&quot;,&quot;type&quot;:&quot;danger&quot;,&quot;showComment&quot;:true,&quot;remarkRequired&quot;:true}]}" />
        </flowable:properties>
      </extensionElements>
      <incoming>flow_skip_data</incoming>
      <incoming>flow_data_approve</incoming>
      <outgoing>flow_sponsor_result</outgoing>
    </userTask>
    <exclusiveGateway id="sponsor_result" name="发起人审批结果" default="flow_sponsor_approve">
      <incoming>flow_sponsor_result</incoming>
      <outgoing>flow_sponsor_reject</outgoing>
      <outgoing>flow_sponsor_approve</outgoing>
    </exclusiveGateway>
    <endEvent id="end_approved" name="立项已批准">
      <incoming>flow_sponsor_approve</incoming>
    </endEvent>
    <endEvent id="end_rejected" name="立项已驳回">
      <incoming>flow_business_reject</incoming>
      <incoming>flow_pmo_reject</incoming>
      <incoming>flow_system_reject</incoming>
      <incoming>flow_architecture_reject</incoming>
      <incoming>flow_security_reject</incoming>
      <incoming>flow_data_reject</incoming>
      <incoming>flow_sponsor_reject</incoming>
    </endEvent>
    <sequenceFlow id="flow_start_business" sourceRef="start" targetRef="business_review" />
    <sequenceFlow id="flow_business_result" sourceRef="business_review" targetRef="business_result" />
    <sequenceFlow id="flow_business_reject" sourceRef="business_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_business_approve" sourceRef="business_result" targetRef="pmo_review" />
    <sequenceFlow id="flow_pmo_result" sourceRef="pmo_review" targetRef="pmo_result" />
    <sequenceFlow id="flow_pmo_reject" sourceRef="pmo_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_pmo_approve" sourceRef="pmo_result" targetRef="system_needed" />
    <sequenceFlow id="flow_need_system" sourceRef="system_needed" targetRef="system_owner_review">
      <conditionExpression xsi:type="tFormalExpression">${project_type != 'RESEARCH'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_system" sourceRef="system_needed" targetRef="architecture_needed" />
    <sequenceFlow id="flow_system_result" sourceRef="system_owner_review" targetRef="system_result" />
    <sequenceFlow id="flow_system_reject" sourceRef="system_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_system_approve" sourceRef="system_result" targetRef="architecture_needed" />
    <sequenceFlow id="flow_need_architecture" sourceRef="architecture_needed" targetRef="architecture_review">
      <conditionExpression xsi:type="tFormalExpression">${project_type == 'NEW_SYSTEM' || project_type == 'INTEGRATION' || project_type == 'MIGRATION' || cross_system_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_architecture" sourceRef="architecture_needed" targetRef="security_needed" />
    <sequenceFlow id="flow_architecture_result" sourceRef="architecture_review" targetRef="architecture_result" />
    <sequenceFlow id="flow_architecture_reject" sourceRef="architecture_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_architecture_approve" sourceRef="architecture_result" targetRef="security_needed" />
    <sequenceFlow id="flow_need_security" sourceRef="security_needed" targetRef="security_review">
      <conditionExpression xsi:type="tFormalExpression">${security_involved_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_security" sourceRef="security_needed" targetRef="data_needed" />
    <sequenceFlow id="flow_security_result" sourceRef="security_review" targetRef="security_result" />
    <sequenceFlow id="flow_security_reject" sourceRef="security_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_security_approve" sourceRef="security_result" targetRef="data_needed" />
    <sequenceFlow id="flow_need_data" sourceRef="data_needed" targetRef="data_review">
      <conditionExpression xsi:type="tFormalExpression">${data_involved_flag == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_skip_data" sourceRef="data_needed" targetRef="sponsor_review" />
    <sequenceFlow id="flow_data_result" sourceRef="data_review" targetRef="data_result" />
    <sequenceFlow id="flow_data_reject" sourceRef="data_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_data_approve" sourceRef="data_result" targetRef="sponsor_review" />
    <sequenceFlow id="flow_sponsor_result" sourceRef="sponsor_review" targetRef="sponsor_result" />
    <sequenceFlow id="flow_sponsor_reject" sourceRef="sponsor_result" targetRef="end_rejected">
      <conditionExpression xsi:type="tFormalExpression">${approved == 'reject'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_sponsor_approve" sourceRef="sponsor_result" targetRef="end_approved" />
  </process>
