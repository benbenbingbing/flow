{
  "info": {
    "_postman_id": "8a06729c-9f28-45d2-936e-07ef483cd926",
    "name": "Flow 开放集成 V1",
    "description": "使用 Client Credentials 调用 Flow 开放流程 API。集合不会持久化 Client Secret；请通过临时环境变量提供。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://flow.example.com", "type": "string" },
    { "key": "clientId", "value": "", "type": "string" },
    { "key": "clientSecret", "value": "", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "processDefinitionKey", "value": "", "type": "string" },
    { "key": "processInstanceId", "value": "", "type": "string" },
    { "key": "messageKey", "value": "external-confirmed", "type": "string" }
  ],
  "item": [
    {
      "name": "01 获取访问令牌",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('令牌签发成功', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.token_type).to.eql('Bearer');",
              "pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('accessToken', body.access_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{clientId}}", "type": "string" },
            { "key": "password", "value": "{{clientSecret}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "client_credentials", "type": "text" },
            {
              "key": "scope",
              "value": "process.definition.read process.instance.start process.instance.read process.task.read process.message.correlate",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/oauth2/token"
      }
    },
    {
      "name": "02 查询授权流程",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('返回 V1 分页结构', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(200);",
              "  pm.expect(body.errorCode).to.eql(null);",
              "  pm.expect(body.data.items).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/open/v1/process-definitions?limit=20"
      }
    },
    {
      "name": "03 幂等发起流程",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.variables.set('idempotencyKey', `postman-${Date.now()}-${pm.variables.replaceIn('{{$randomUUID}}')}`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('流程已创建', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const body = pm.response.json();",
              "pm.expect(body.data.processInstanceId).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('processInstanceId', body.data.processInstanceId);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"processKey\": \"{{processDefinitionKey}}\",\n  \"businessReference\": {\n    \"system\": \"postman\",\n    \"type\": \"acceptance\",\n    \"id\": \"{{idempotencyKey}}\"\n  },\n  \"initiator\": null,\n  \"variables\": {}\n}"
        },
        "url": "{{baseUrl}}/api/open/v1/process-instances"
      }
    },
    {
      "name": "04 查询流程状态",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/open/v1/process-instances/{{processInstanceId}}"
      }
    },
    {
      "name": "05 查询活动任务",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/open/v1/process-instances/{{processInstanceId}}/tasks?limit=20"
      }
    },
    {
      "name": "06 关联消息",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "message-{{$randomUUID}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variables\": {}\n}"
        },
        "url": "{{baseUrl}}/api/open/v1/process-instances/{{processInstanceId}}/messages/{{messageKey}}"
      }
    }
  ]
}
