{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow.example/schemas/events/process-terminated-v1.schema.json",
  "title": "Flow process terminated event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "traceid",
    "data"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "source": { "const": "/flow/process" },
    "type": { "const": "com.flow.process.terminated.v1" },
    "subject": {
      "type": "string",
      "pattern": "^process-instance/[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "const": "/schemas/events/process-terminated-v1.schema.json" },
    "traceid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processInstanceId",
        "processKey",
        "status",
        "businessReference",
        "terminatedAt"
      ],
      "properties": {
        "processInstanceId": { "$ref": "#/$defs/publicId" },
        "processKey": { "$ref": "#/$defs/key" },
        "status": { "const": "TERMINATED" },
        "businessReference": { "$ref": "#/$defs/businessReference" },
        "scenarioKey": { "$ref": "#/$defs/key" },
        "bindingRevision": { "type": "integer", "minimum": 1 },
        "subjectVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identityNamespace": { "$ref": "#/$defs/key" },
        "reasonCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "terminatedAt": { "type": "string", "format": "date-time" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence": { "type": "string", "maxLength": 4096 },
        "outcome": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
        "failureCode": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "outcomeCode": { "$ref": "#/$defs/key" }
      }
    }
  },
  "$defs": {
    "publicId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "businessReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "type", "id"],
      "properties": {
        "system": { "$ref": "#/$defs/key" },
        "type": { "$ref": "#/$defs/key" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
