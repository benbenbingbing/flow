# Local MySQL. Use independent values for root, runtime, and schema identities.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workflow
DB_ROOT_PASSWORD=replace-with-a-local-root-password
DB_USERNAME=workflow
DB_PASSWORD=replace-with-a-local-runtime-password
SCHEMA_DB_USERNAME=workflow_schema
SCHEMA_DB_PASSWORD=replace-with-a-local-schema-password

SPRING_DATASOURCE_URL='jdbc:mysql://localhost:3306/workflow?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&connectionCollation=utf8mb4_unicode_ci&nullCatalogMeansCurrent=true'
SCHEMA_DATASOURCE_URL='jdbc:mysql://localhost:3306/workflow?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&connectionCollation=utf8mb4_unicode_ci&nullCatalogMeansCurrent=true'

SERVER_PORT=8080
WEB_PORT=3000
START_LOCAL_MYSQL=auto
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FILE_STORAGE_PATH=uploads
FILE_STORAGE_ACCESS_URL=/uploads
VITE_API_BASE_URL=/api

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CONFIG_MIGRATION_SIGNING_KEY=replace-with-an-independent-random-signing-key
WORKFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Optional open-integration runtimes. Disabled capabilities remain visible in
# the management page with an explicit "not enabled" state instead of 404.
WORKFLOW_OPEN_API_ENABLED=false
WORKFLOW_OPEN_API_WEBHOOK_ENABLED=false
WORKFLOW_OPEN_API_WEBHOOK_MASTER_KEY=
WORKFLOW_INTEGRATION_CONNECTOR_HTTP_ENABLED=false
WORKFLOW_INTEGRATION_CONNECTOR_HTTP_MASTER_KEY_VERSION=
WORKFLOW_INTEGRATION_CONNECTOR_HTTP_MASTER_KEY=
