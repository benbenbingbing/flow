# Local MySQL. Use independent values for root, runtime, and schema identities.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workflow
DB_ROOT_PASSWORD=replace-with-a-local-root-password
DB_USERNAME=workflow
DB_PASSWORD=replace-with-a-local-runtime-password
SCHEMA_DB_USERNAME=workflow_schema
SCHEMA_DB_PASSWORD=replace-with-a-local-schema-password

SPRING_DATASOURCE_URL='jdbc:mysql://localhost:3306/workflow?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&connectionCollation=utf8mb4_unicode_ci&nullCatalogMeansCurrent=true'
SCHEMA_DATASOURCE_URL='jdbc:mysql://localhost:3306/workflow?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&connectionCollation=utf8mb4_unicode_ci&nullCatalogMeansCurrent=true'

SERVER_PORT=8080
WEB_PORT=3000
MOBILE_PORT=3001
# 真机调试时填写开发机局域网 IP/主机名，start.sh 将精确添加两个前端 Origin。
FLOW_DEV_HOST=
START_LOCAL_MYSQL=auto
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://localhost:8443

FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=uploads
FILE_STORAGE_ACCESS_URL=/uploads
# Optional S3 upload/delete directory and extra download buckets (comma-separated).
FILE_STORAGE_S3_KEY_PREFIX=
FILE_STORAGE_S3_READABLE_BUCKETS=
# Opt-in only: disables S3 certificate and hostname verification, exposing requests to interception.
FILE_STORAGE_S3_TRUST_ALL_CERTIFICATES=false
# Optional MinIO: set FILE_STORAGE_TYPE=minio and fill these values.
# Use the object API endpoint (usually port 9000), not the console (9001).
FILE_STORAGE_MINIO_ENDPOINT=
FILE_STORAGE_MINIO_REGION=us-east-1
FILE_STORAGE_MINIO_BUCKET=
# Upload/delete directory; downloads may read other directories in the default bucket.
FILE_STORAGE_MINIO_KEY_PREFIX=
# Extra download buckets on the same endpoint; credentials must also allow object reads.
FILE_STORAGE_MINIO_READABLE_BUCKETS=
FILE_STORAGE_MINIO_ACCESS_KEY=
FILE_STORAGE_MINIO_SECRET_KEY=
FILE_STORAGE_MINIO_ACCESS_URL=
# Opt-in only: disables MinIO certificate and hostname verification, exposing requests to interception.
FILE_STORAGE_MINIO_TRUST_ALL_CERTIFICATES=false
VITE_API_BASE_URL=/api

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
WORKFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Optional machine-auth entrypoint used by Embed launch.
WORKFLOW_OPEN_API_ENABLED=false
